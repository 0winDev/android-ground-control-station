<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application>
        <!--
            Debug builds only: sends a vehicle command from adb for the SITL check (#98). DUMP is a
            signature|privileged|development permission that only the shell and the system hold, so no other app
            can send it.
        -->
        <receiver
            android:name=".debug.SitlCommandReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.owindev.gcs.debug.SEND_COMMAND" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
