<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12 and higher: https://developer.android.com/identity/data/autobackup (S-4). -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Flight logs: a record of where the vehicle flew stays on this device. -->
        <exclude domain="file" path="tlogs" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="tlogs" />
    </device-transfer>
</data-extraction-rules>
